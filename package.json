{
  "name": "motion-skills-lab-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=11.24.0"
  },
  "scripts": {
    "prototype": "pnpm build:packages && pnpm --filter @motion-skills-lab/showcase dev --port 4180 --strictPort",
    "dev": "pnpm build:packages && pnpm --filter @motion-skills-lab/showcase dev",
    "build:packages": "pnpm --filter @motion-skills-lab/motion-tokens build && pnpm --filter @motion-skills-lab/motion-recipes build",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm build:packages && tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm build:packages && vitest run && node --test scripts/check-publication-ready.test.mjs",
    "test:e2e": "pnpm build && playwright test",
    "validate:skills": "node scripts/validate-skills.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:consumer": "pnpm build:packages && node scripts/check-consumer.mjs",
    "check:showcase": "node scripts/check-showcase-build.mjs",
    "check:publication": "pnpm check:showcase && node scripts/check-publication-ready.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "type": "module",
  "license": "MIT"
}
